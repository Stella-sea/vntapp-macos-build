+/// 把工作目录固定到应用支持目录,避免相对路径 logs/ 因启动方式不同而找不到
+Future<void> setupStableWorkDir() async {
+  if (!Platform.isMacOS && !Platform.isLinux && !Platform.isWindows) {
+    return;
+  }
+  final dir = await getApplicationSupportDirectory();
+  if (!dir.existsSync()) {
+    await dir.create(recursive: true);
+  }
+  Directory.current = dir;
+}
+
+/// 当前是否以 root/管理员身份运行(macOS 上建虚拟网卡需要 root)
+Future<bool> isRunningAsRoot() async {
+  if (!Platform.isMacOS) return true;
+  try {
+    final result = await Process.run('id', ['-u']);
+    return result.stdout.toString().trim() == '0';
+  } catch (_) {
+    return false;
+  }
+}
+
+/// 用系统密码框以管理员身份重新启动当前应用(macOS)
+Future<bool> relaunchAsAdmin() async {
+  if (!Platform.isMacOS) return false;
+  final exe = Platform.resolvedExecutable;
+  try {
+    final script =
+        'do shell script "nohup \\"$exe\\" > /dev/null 2>&1 &" with administrator privileges';
+    final result = await Process.run('osascript', ['-e', script]);
+    return result.exitCode == 0;
+  } catch (e) {
+    debugPrint('relaunchAsAdmin error: $e');
+    return false;
+  }
+}
