+  Future<void> _relaunchAsAdminAndExit() async {
+    if (adminRelaunchInProgress) return;
+    adminRelaunchInProgress = true;
+    try {
+      final random = Random.secure();
+      final token = List.generate(16, (_) =>
+          random.nextInt(256).toRadixString(16).padLeft(2, '0')).join();
+      if (!await relaunchAsAdmin(token)) {
+        if (!mounted) return;
+        ScaffoldMessenger.of(context).showSnackBar(
+          const SnackBar(content: Text('未能以管理员身份启动，请用终端 sudo 打开')),
+        );
+        return;
+      }
+      final readyFile = File('/tmp/vnt_app-ready-$token');
+      final timer = Stopwatch()..start();
+      while (timer.elapsed < const Duration(seconds: 30)) {
+        if (await readyFile.exists()) {
+          exit(0);
+        }
+        await Future<void>.delayed(const Duration(milliseconds: 250));
+      }
+    } catch (e) {
+      debugPrint('管理员重启就绪检查失败: $e');
+    } finally {
+      adminRelaunchInProgress = false;
+    }
+    if (!mounted) return;
+    ScaffoldMessenger.of(context).showSnackBar(
+      const SnackBar(content: Text(
+          '新实例未能启动，已保留当前实例，请用终端 sudo 打开并查看 /tmp/vnt_app-root.log')),
+    );
+  }
