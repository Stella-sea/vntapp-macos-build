+/// 当前是否以 root/管理员身份运行(macOS 上建虚拟网卡需要 root)
+Future<bool> isRunningAsRoot() async {
+  if (!Platform.isMacOS) return true;
+  try {
+    final result = await Process.run('id', ['-u']);
+    return result.stdout.toString().trim() == '0';
+  } catch (_) {
+    return false;
+  }
+}
+
+/// 用系统密码框以管理员身份重新启动当前应用(macOS)
+/// 关键:提权助手运行在 root 的 Mach bootstrap 里,不在用户 Aqua 会话中,
+/// 直接启动 GUI 会连不上 WindowServer 而闪退(r3/r4 的教训)。
+/// 须用 launchctl asuser 把进程放回当前登录用户的 Aqua 会话,
+/// 同时保持 root 身份(不降权)。日志写到 /tmp/vnt_app-root.log 便于排查。
+Future<bool> relaunchAsAdmin(String token) async {
+  if (!Platform.isMacOS) return false;
+  try {
+    final uidResult = await Process.run('stat', ['-f', '%u', '/dev/console']);
+    final userResult = await Process.run('stat', ['-f', '%Su', '/dev/console']);
+    final consoleUid = uidResult.stdout.toString().trim();
+    final consoleUser = userResult.stdout.toString().trim();
+    if (uidResult.exitCode != 0 || userResult.exitCode != 0 ||
+        consoleUid.isEmpty || consoleUser.isEmpty) {
+      debugPrint('relaunchAsAdmin: 无法获取控制台用户: '
+          'uid=${uidResult.exitCode} ${uidResult.stderr}, '
+          'user=${userResult.exitCode} ${userResult.stderr}, '
+          'uid或用户名为空=${consoleUid.isEmpty || consoleUser.isEmpty}');
+      return false;
+    }
+
+    // 先处理 shell 单引号，再处理 AppleScript 字符串的反斜杠和双引号。
+    String shellQuote(String value) => "'${value.replaceAll("'", "'\\''")}'";
+    String appleScriptEscape(String value) =>
+        value.replaceAll('\\', '\\\\').replaceAll('"', '\\"');
+    final userPlist = shellQuote(
+        '/Users/$consoleUser/Library/Preferences/top.wherewego.vntApp.plist');
+    final rootPlist = shellQuote(
+        '/var/root/Library/Preferences/top.wherewego.vntApp.plist');
+    final prefix = 'if [ -f $userPlist ] && '
+        '{ [ ! -e $rootPlist ] || [ $userPlist -nt $rootPlist ]; }; then '
+        'mkdir -p /var/root/Library/Preferences && '
+        'cp $userPlist $rootPlist || exit 1; fi; '
+        '/bin/launchctl asuser ${shellQuote(consoleUid)} ';
+    final suffix = ' --vnt-ready-token=$token '
+        '> /tmp/vnt_app-root.log 2>&1 < /dev/null &';
+    final exe = appleScriptEscape(Platform.resolvedExecutable);
+    final script = 'do shell script ("${appleScriptEscape(prefix)}" & '
+        '(quoted form of "$exe") & "${appleScriptEscape(suffix)}") '
+        'with administrator privileges';
+    final result = await Process.run('osascript', ['-e', script]);
+    return result.exitCode == 0;
+  } catch (e) {
+    debugPrint('relaunchAsAdmin error: $e');
+    return false;
+  }
+}
 
